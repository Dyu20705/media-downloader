{
  "name": "one-click-media-downloader",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "tauri": "tauri",
    "check:ci": "node scripts/ci/check-boundaries.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
